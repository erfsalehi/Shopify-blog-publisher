# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Env / secrets
.env
.env.local
# Every .env variant, including the timestamped backups a rotation leaves
# behind (.env.bak-20260805-135123 and friends) — those hold the same live
# credentials as .env itself and were showing up as untracked-but-committable.
.env.*
!.env.example

# Data
data/
*.db
*.sqlite
*.sqlite3

# Model cache (fastembed)
.fastembed_cache/

# Test / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Service-account keys. Never commit these — the repo is public, and a
# leaked key is a live credential until it is revoked in Google Cloud.
keys/
*.json.key
service-account*.json

.vercel
neon-url.txt
*-url.txt
preview_convert.html
